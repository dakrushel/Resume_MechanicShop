<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MechanicShop.Views.OrderView"
             Title="Repair Orders">

    <ScrollView>
        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" >
            <!--============================================================================================-->
            <!--APPOINTMENT SLIP WIDGET=====================================================================-->
            <!--============================================================================================-->
            <Border x:Name="orderSlip" HorizontalOptions="Center" Padding="20"
                    HeightRequest="700" WidthRequest="500" IsEnabled="true">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="5">

                    <Label Text="Repair Order" FontSize="20" TextDecorations="Underline"/>

                    <HorizontalStackLayout  x:Name="cInformation" Padding="5" Spacing="5"
                                            BindingContext="Customer">
                        <Label Text="Customer Name:"/>
                        <Label Text="{Binding Name}" WidthRequest="150"
                                FontAttributes="Bold"/>
                        <Label Text="Phone #:"/>
                        <Label Text="{Binding CustomerPhone}"
                                FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                    <Label Text="======================================================="
                                HorizontalOptions="Center"/>
                    <Label Text="Vehicle Information" FontAttributes="Bold"/>
                    <Grid x:Name="vInformation" ColumnSpacing="5" RowSpacing="5" 
                            HorizontalOptions="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                            <ColumnDefinition Width="60"></ColumnDefinition>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                            <ColumnDefinition Width="150"></ColumnDefinition>

                        </Grid.ColumnDefinitions>
                        <Label Text="Year:" 
                                HorizontalOptions="End"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Year}"
                                FontAttributes="Bold" HorizontalOptions="Start"/>

                        <Label Grid.Column="2" Grid.Row="0" Text="Make:" HorizontalOptions="End"/>
                        <Label Grid.Row="0" Grid.Column="3" HorizontalOptions="Start" 
                                FontAttributes="Bold" Text="{Binding Make}"/>

                        <Label Grid.Column="4" Grid.Row="0" 
                                Text="Model:" HorizontalOptions="End"/>
                        <Label Grid.Row="0" Grid.Column="5" HorizontalOptions="Start"
                                FontAttributes="Bold" Text="{Binding Model}"/>

                        <Label Grid.Column="4" Grid.Row="1" 
                                Text="Colour:" HorizontalOptions="End"/>
                        <Label Grid.Row="1" Grid.Column="5" HorizontalOptions="Start"
                                FontAttributes="Bold" Text="{Binding Colour}"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="VIN:" 
                                HorizontalOptions="End"/>
                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                                FontAttributes="Bold" Text="{Binding VIN}"
                                HorizontalOptions="Start"/>
                    </Grid>
                    <Label Text="======================================================="
                                HorizontalOptions="Center"/>
                    <!--(RepairOrderDescription : string)-->
                    <Label Text="Problem Description:"/>
                    <Editor WidthRequest="450" HeightRequest="100" Background="{StaticResource White}" 
                            x:Name="problemDescriptionEntry" 
                            Placeholder="Enter problem description here"/>
                    <!--REPAIR ORDER JOBS (For currently displayed repair order)-->
                    <Label Text="Jobs:" Margin="0,5,0,0"/>
                    <ListView x:Name="repairOrderJobs" 
                                HeightRequest="100" WidthRequest="450" Background="AliceBlue">
                        <!--All jobs that have been added to this repair order go here-->
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"></ColumnDefinition>
                                            <ColumnDefinition Width="340"></ColumnDefinition>
                                            <ColumnDefinition Width="50"></ColumnDefinition>

                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="{Binding ServiceJobId}" HorizontalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding ServiceJobDescription}"/>
                                        <Label Grid.Column="2" Text="{Binding ServiceJobHours}" HorizontalOptions="Center"/>
                                    </Grid>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="removeJobBtn" Text="Remove Job" BackgroundColor="maroon"
                            TextColor="White" WidthRequest="250" IsEnabled="False"/>
                    <!--Price Quote information-->
                    <HorizontalStackLayout Margin="0,10,0,0">
                        <Label Text="Price Estimate (before fees):" VerticalOptions="Center"/>
                        <Label x:Name="priceEstimate" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <!--TECHNICIAN-->
                    <HorizontalStackLayout WidthRequest="450" Spacing="10">
                        <Label Text="Technician:" VerticalOptions="Center" FontSize="16"/>
                        <Picker x:Name="assignTechPicker" WidthRequest="300"
                                SelectedIndexChanged="assignTechPicker_SelectedIndexChanged"/>
                    </HorizontalStackLayout>
                    <!--SHEDULE APPOINTMENT BUTTON-->
                    <Button Text="Close Repair Order and Generate Invoice" IsEnabled="true" TextColor="black"
                    x:Name="scheduleAppointment" Background="{StaticResource Tertiary}"/>


                    <!--CONVERT TO RO BUTTON-->
                    <HorizontalStackLayout x:Name="apptOptions" IsVisible="false" 
                               Spacing="10" HorizontalOptions="Center">
                        <Button x:Name="deleteAppt" Text="Delete" BackgroundColor="maroon"
                    TextColor="white" WidthRequest="100"
                    Clicked="deleteAppt_Clicked"/>
                        <Button x:Name="updateAppt" Text="Update Details" WidthRequest="130"
                    Clicked="updateAppt_Clicked" IsEnabled="False"/>
                        <Button Text="Convert to Repair Order" TextColor="black"
                    Background="{StaticResource Tertiary}" x:Name="makeRO"
                    Clicked="makeRO_Clicked" HorizontalOptions="FillAndExpand"/>
                    </HorizontalStackLayout>



                </VerticalStackLayout>

            </Border>
            <!--============================================================================================-->
            <!--REPAIR ORDERS IN SYSTEM=====================================================================-->
            <!--============================================================================================-->
            <Border HorizontalOptions="Center" Padding="20"
                    x:Name="roLogs" IsVisible="true">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="Repair Orders:" FontSize="25"/>
                    <Label Text="Not Assigned:"/>
                    <ListView x:Name="unasignedROs"
                                HeightRequest="200" WidthRequest="400" Background="AliceBlue"
                                ItemSelected="unasignedROs_ItemSelected">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"></ColumnDefinition>
                                            <ColumnDefinition Width="200"></ColumnDefinition>
                                            <ColumnDefinition Width="140"></ColumnDefinition>

                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="{Binding RepairOrderId}" HorizontalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding CustomerName}"/>
                                        <Label Grid.Column="2" Text="{Binding VIN}" HorizontalOptions="Start"/>
                                    </Grid>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Label Text="In Progress:" Margin="0,20,0,0"/>
                    <ListView x:Name="inProgressROs"
                                HeightRequest="100" WidthRequest="400" Background="AliceBlue"
                                ItemSelected="inProgressROs_ItemSelected">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"></RowDefinition>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"></ColumnDefinition>
                                            <ColumnDefinition Width="240"></ColumnDefinition>
                                            <ColumnDefinition Width="100"></ColumnDefinition>

                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="{Binding RepairOrderId}" HorizontalOptions="Center"/>
                                        <Label Grid.Column="1" Text="{Binding CustomerName}"/>
                                        <Label Grid.Column="2" Text="{Binding VIN}" HorizontalOptions="Start"/>
                                    </Grid>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </VerticalStackLayout>
            </Border>


            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="50">
                <!--============================================================================================-->
                <!--Technician Menu=====================================================================-->
                <!--============================================================================================-->
                <Border HorizontalOptions="Center" Padding="20" WidthRequest="500"
        x:Name="technicianMenu" 
        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Available Technicians:" FontSize="25" TextDecorations="Underline"/>
                        <!--service jobs list (all service jobs)-->
                        <!--Technician List View-->
                        <ListView Grid.ColumnSpan="2" Grid.Row="4" 
                    x:Name="techList" WidthRequest="450"
                    HeightRequest="100" Background="AliceBlue">
                            <ListView.ItemTemplate>
                                <DataTemplate>

                                    <ViewCell>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"></ColumnDefinition>
                                                <ColumnDefinition Width="200"></ColumnDefinition>
                                                <ColumnDefinition Width="200"></ColumnDefinition>

                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Text="{Binding EmployeeId}"></Label>
                                            <Label Grid.Column="1" Text="{Binding Name}"></Label>
                                            <Label Grid.Column="2" Text="{Binding Specialization}"></Label>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                    </VerticalStackLayout>
                </Border>
                <!--============================================================================================-->
                <!--Service Job Menu=====================================================================-->
                <!--============================================================================================-->
                <Border HorizontalOptions="Center" Padding="20" WidthRequest="500"
                        x:Name="serviceJobMenu" 
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Service Jobs:" FontSize="25" TextDecorations="Underline"/>
                        <!--service jobs list (all service jobs)-->
                        <ListView x:Name="serviceJobs" 
                                    HeightRequest="200" WidthRequest="460" Background="AliceBlue">
                            <!--All jobs that have been added to this repair order go here-->
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <ViewCell>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"></RowDefinition>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"></ColumnDefinition>
                                                <ColumnDefinition Width="340"></ColumnDefinition>
                                                <ColumnDefinition Width="50"></ColumnDefinition>

                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" Text="{Binding ServiceJobId}" HorizontalOptions="Center"/>
                                            <Label Grid.Column="1" Text="{Binding ServiceJobDescription}"/>
                                            <Label Grid.Column="2" Text="{Binding ServiceJobHours}" HorizontalOptions="Start"/>
                                        </Grid>
                                    </ViewCell>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <HorizontalStackLayout x:Name="thisJob" HorizontalOptions="Center">
                            <Entry Text="{Binding ServiceJobId}"
                                    WidthRequest="50" HorizontalTextAlignment="Center"/>
                            <Entry Text="{Binding ServiceJobDescription}"
                                    WidthRequest="340"/>
                            <Entry Text="{Binding ServiceJobHours}"
                                    WidthRequest="50"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                            <Button Text="Close" WidthRequest="150" Background="maroon" TextColor="white"
                                    x:Name="closeServiceJobMenu" />
                            <Button Text="Add This Job" WidthRequest="280"
                                    x:Name="addThisJob" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                


            </VerticalStackLayout>




        </HorizontalStackLayout>
        
    </ScrollView>
  
</ContentPage>