<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MechanicShop.Views.OrderView"
             Title="Repair Orders">
    <!--Order View Page (Written by Chloe)
        This page displays listd of ACTIVE repair orders. This means that the appointments had been converted into
    a repair order because the customer has arrived and checked in the vehicle. There are two seperate lists. 
    One for unassigned RO's - meaning the vehiucle is here but NOT in a mecanic's bay
    and one for In Progress RO's - meaning the vehicle has a technician assigned and is being actively worked on.
    
    From this page you can view and edit repair order details including:
    - Adding or removing jobs (automatically updates estimate)
    - Assign a technician
    - Edit the problem description
    
    You can also delete RO's from here
    And once all information is present, you can Close a repair order, This will generate an invlice
    for the customer to pay, and to give the customer a record of the work performed, and then will delete the 
    Rwepair Order from the system
        -->
    <ScrollView>
        <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="100">
            <!--============================================================================================-->
            <!--ORDER SLIP WIDGET=====================================================================-->
            <!--============================================================================================-->
            <Border x:Name="orderSlip" HorizontalOptions="Center" Padding="20"
                     WidthRequest="500" IsEnabled="true" IsVisible="false">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="5">
                    <HorizontalStackLayout VerticalOptions="Center" Spacing="160" Padding="1">
                        <Label Text="Repair Order" FontSize="25" TextDecorations="Underline" VerticalOptions="Center"/>
                        <Button x:Name="Clear" Text="Back to All RO's"
                                Clicked="Clear_Clicked"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout  x:Name="cInformation" Padding="5" Spacing="5"
                                            BindingContext="Customer">
                        <Label Text="Customer Name:"/>
                        <Label Text="{Binding Name}" WidthRequest="150"
                                FontAttributes="Bold"/>
                        <Label Text="Phone #:"/>
                        <Label Text="{Binding CustomerPhone}"
                                FontAttributes="Bold"/>
                    </HorizontalStackLayout>
                    <Label Text="======================================================="
                                HorizontalOptions="Center"/>
                    <Label Text="Vehicle Information" FontAttributes="Bold"/>
                    <Grid x:Name="vInformation" ColumnSpacing="5" RowSpacing="5" 
                            HorizontalOptions="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                            <ColumnDefinition Width="60"></ColumnDefinition>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                            <ColumnDefinition Width="80"></ColumnDefinition>
                            <ColumnDefinition Width="50"></ColumnDefinition>
                            <ColumnDefinition Width="150"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Label Text="Year:" 
                                HorizontalOptions="End"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Year}"
                                FontAttributes="Bold" HorizontalOptions="Start"/>
                        <Label Grid.Column="2" Grid.Row="0" Text="Make:" HorizontalOptions="End"/>
                        <Label Grid.Row="0" Grid.Column="3" HorizontalOptions="Start" 
                                FontAttributes="Bold" Text="{Binding Make}"/>
                        <Label Grid.Column="4" Grid.Row="0" 
                                Text="Model:" HorizontalOptions="End"/>
                        <Label Grid.Row="0" Grid.Column="5" HorizontalOptions="Start"
                                FontAttributes="Bold" Text="{Binding Model}"/>
                        <Label Grid.Column="4" Grid.Row="1" 
                                Text="Colour:" HorizontalOptions="End"/>
                        <Label Grid.Row="1" Grid.Column="5" HorizontalOptions="Start"
                                FontAttributes="Bold" Text="{Binding Colour}"/>
                        <Label Grid.Row="1" Grid.Column="0" Text="VIN:" 
                                HorizontalOptions="End"/>
                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                                FontAttributes="Bold" Text="{Binding VIN}"
                                HorizontalOptions="Start"/>
                    </Grid>
                    <Label Text="======================================================="
                                HorizontalOptions="Center"/>
                    <!--(RepairOrderDescription : string)-->
                    <Border Background="AntiqueWhite" Padding="5">
                        <VerticalStackLayout>
                            <Label Text="Problem Description:"/>
                            <Editor WidthRequest="450" HeightRequest="100" Background="{StaticResource White}" 
                                    x:Name="problemDescriptionEntry" MaxLength="500"
                                    Placeholder="Enter problem description here"
                                    TextChanged="problemDescriptionEntry_TextChanged"/>
                        </VerticalStackLayout>
                    </Border>
                    <!--REPAIR ORDER JOBS (For currently displayed repair order)-->
                    <Label Text="Jobs:" Margin="0,5,0,0"/>
                    <Border Padding="5" WidthRequest="450" Background="AntiqueWhite">
                        <VerticalStackLayout>
                            <HorizontalStackLayout Margin="0,2" HorizontalOptions="Center">
                                <Label Text="   #" WidthRequest="50" FontSize="16" TextDecorations="Underline"/>
                                <Label Text="Service job" WidthRequest="340" FontSize="16" TextDecorations="Underline"/>
                                <Label Text="Hours" WidthRequest="50" FontSize="16" TextDecorations="Underline"/>
                            </HorizontalStackLayout>
                            <ListView x:Name="repairOrderJobs" ItemSelected="repairOrderJobs_ItemSelected"
                                    HeightRequest="100" WidthRequest="440" Background="AliceBlue">
                                <!--All jobs that have been added to this repair order go here-->
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                                    <ColumnDefinition Width="340"></ColumnDefinition>
                                                    <ColumnDefinition Width="50"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Text="{Binding ServiceJobId}" HorizontalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding ServiceJobDescription}"/>
                                                <Label Grid.Column="2" Text="{Binding ServiceJobHours}" HorizontalOptions="Center"/>
                                            </Grid>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </VerticalStackLayout>
                    </Border>
                    <Button x:Name="removeJobBtn" Text="Remove Job" BackgroundColor="maroon"
                            TextColor="White" WidthRequest="250" IsEnabled="False"
                            Clicked="removeJobBtn_Clicked"/>
                    <!--Price Quote information-->
                    <HorizontalStackLayout Margin="0,10,0,0" Spacing="20">
                        <Label Text="Price Estimate (before fees):" VerticalOptions="Center"/>
                        <Label x:Name="priceEstimate" VerticalOptions="Center" FontAttributes="Bold" FontSize="18"/>
                    </HorizontalStackLayout>
                    <!--TECHNICIAN-->
                    <HorizontalStackLayout WidthRequest="450" Spacing="10">
                        <Label Text="Technician:" VerticalOptions="Center" FontSize="16"/>
                        <Label x:Name="selectedTech" Text="::Not Assigned::" WidthRequest="220" FontAttributes="Bold" FontSize="18"
                               VerticalOptions="Center"/>
                        <Button Text="Remove Tech" VerticalOptions="Center" IsEnabled="False"
                                x:Name="removeTech" Clicked="removeTech_Clicked"/>
                    </HorizontalStackLayout>
                    <!--OPTION BUTTONS-->
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center" Margin="0,20,0,0">
                        <Button x:Name="DeleteRO" Text="Delete RO" BackgroundColor="maroon" TextColor="white"
                                Clicked="DeleteRO_Clicked"/>
                        <Button x:Name="updateRO" Text="Save Changes" IsEnabled="False"
                                Clicked="updateRO_Clicked"/>
                        <Button x:Name="closeRO" Text="Close and Invoice" WidthRequest="210" TextColor="Black"
                                BackgroundColor="{StaticResource Tertiary}" IsEnabled="False"
                                Clicked="closeRO_Clicked"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
            <!--============================================================================================-->
            <!--REPAIR ORDERS IN SYSTEM=====================================================================-->
            <!--============================================================================================-->
            <Border HorizontalOptions="Center" Padding="20"
                    x:Name="roLogs" IsVisible="true">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label Text="Repair Orders:" FontSize="25"/>
                    <Label Text="Not Assigned:" FontSize="16"/>
                    <Border Padding="5" WidthRequest="450" Background="AntiqueWhite">
                        <VerticalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,2">
                                <Label Text="  #" WidthRequest="40" FontSize="16" TextDecorations="Underline"/>
                                <Label Text="Customer Name" WidthRequest="240" FontSize="16" TextDecorations="Underline"/>
                                <Label Text="Vehicle VIN" WidthRequest="160" FontSize="16" TextDecorations="Underline"/>
                            </HorizontalStackLayout>
                            <ListView x:Name="unasignedROs"
                                        HeightRequest="200" WidthRequest="440" Background="AliceBlue"
                                        ItemSelected="ROs_ItemSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"></ColumnDefinition>
                                                    <ColumnDefinition Width="240"></ColumnDefinition>
                                                    <ColumnDefinition Width="160"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Text="{Binding RepairOrderId}" HorizontalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding CustomerName}"/>
                                                <Label Grid.Column="2" Text="{Binding VIN}" HorizontalOptions="Start"/>
                                            </Grid>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </VerticalStackLayout>
                    </Border>
                    <Label Text="In Progress:" Margin="0,20,0,0" FontSize="16"/>
                    <Border Padding="5" WidthRequest="450" Background="AntiqueWhite">
                        <VerticalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="Center" Margin="0,2">
                                <Label Text="  #" WidthRequest="40" FontSize="16" TextDecorations="Underline"/>
                                <Label Text="Customer Name" WidthRequest="240" FontSize="16" TextDecorations="Underline"/>
                                <Label Text="Vehicle VIN" WidthRequest="160" FontSize="16" TextDecorations="Underline"/>
                            </HorizontalStackLayout>
                            <ListView x:Name="inProgressROs"
                                    HeightRequest="100" WidthRequest="440" Background="AliceBlue"
                                    ItemSelected="ROs_ItemSelected">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="auto"></RowDefinition>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"></ColumnDefinition>
                                                    <ColumnDefinition Width="240"></ColumnDefinition>
                                                    <ColumnDefinition Width="160"></ColumnDefinition>
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0" Text="{Binding RepairOrderId}" HorizontalOptions="Center"/>
                                                <Label Grid.Column="1" Text="{Binding CustomerName}"/>
                                                <Label Grid.Column="2" Text="{Binding VIN}" HorizontalOptions="Start"/>
                                            </Grid>
                                        </ViewCell>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </VerticalStackLayout>
                    </Border>
                    <!--Search Repair Orders-->
                    <Label Text="Find Repair Order:" Margin="0,20,0,0" FontSize="18"/>
                    <HorizontalStackLayout Spacing="10" WidthRequest="400">
                        <Label Text="Name:" WidthRequest="50"
                                VerticalOptions="Center" HorizontalOptions="End"/>
                        <Entry x:Name="roName" WidthRequest="200" Background="White" MaxLength="28"
                                TextChanged="roName_TextChanged" Placeholder="Customer Name"/>
                        <Button x:Name="searchName" Text="Search Name" WidthRequest="125"
                                Clicked="searchName_Clicked" IsEnabled="False"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="10" WidthRequest="400">
                        <Label Text="Phone:" WidthRequest="50"
                                VerticalOptions="Center" HorizontalOptions="End"/>
                        <Entry x:Name="roPhone" WidthRequest="200" Background="White" 
                                TextChanged="roPhone_TextChanged" Placeholder="000-000-0000"/>
                        <Button x:Name="SearchPhone" Text="Search Phone" WidthRequest="125"
                                Clicked="SearchPhone_Clicked" IsEnabled="False"/>
                    </HorizontalStackLayout>
                    <Button x:Name="clearSearchForm" Text="Clear Search" IsEnabled="False"
                             Clicked="clearSearchForm_Clicked" WidthRequest="200"/>

                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="50">
                <!--============================================================================================-->
                <!--Technician Menu=====================================================================-->
                <!--============================================================================================-->
                <Border HorizontalOptions="Center" Padding="20" WidthRequest="500"
                        x:Name="technicianMenu" HeightRequest="290"
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Available Technicians:" FontSize="25" TextDecorations="Underline"/>
                        <!--Technician List View-->
                        <Border WidthRequest="450" Padding="5" Background="AntiqueWhite">
                            <VerticalStackLayout>
                                <HorizontalStackLayout HorizontalOptions="Center" Margin="0,2">
                                    <Label Text="ID" WidthRequest="50" FontSize="16" TextDecorations="Underline"/>
                                    <Label Text="Name" WidthRequest="200" FontSize="16" TextDecorations="Underline"/>
                                    <Label Text="Specialty" WidthRequest="190" FontSize="16" TextDecorations="Underline"/>
                                </HorizontalStackLayout>
                                <ListView Grid.ColumnSpan="2" Grid.Row="4" ItemSelected="techList_ItemSelected"
                                        x:Name="techList" WidthRequest="440"
                                        HeightRequest="100" Background="AliceBlue">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>

                                            <ViewCell>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"></RowDefinition>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"></ColumnDefinition>
                                                        <ColumnDefinition Width="200"></ColumnDefinition>
                                                        <ColumnDefinition Width="190"></ColumnDefinition>

                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" Text="{Binding EmployeeId}"></Label>
                                                    <Label Grid.Column="1" Text="{Binding Name}"></Label>
                                                    <Label Grid.Column="2" Text="{Binding Specialization}"></Label>
                                                </Grid>
                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </VerticalStackLayout>
                        </Border>
                        <Button x:Name="assignTech" Text="Assign Technician" WidthRequest="400" IsEnabled="False"
                                Clicked="assignTech_Clicked"/>
                    </VerticalStackLayout>
                </Border>
                <!--============================================================================================-->
                <!--Service Job Menu=====================================================================-->
                <!--============================================================================================-->
                <Border HorizontalOptions="Center" Padding="20" WidthRequest="500"
                        x:Name="serviceJobMenu" HeightRequest="430"
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Service Jobs:" FontSize="25" TextDecorations="Underline"/>
                        <!--service jobs list (all service jobs)-->
                        <Border WidthRequest="450" Background="AntiqueWhite">
                            <VerticalStackLayout>
                                <HorizontalStackLayout Margin="0,2" HorizontalOptions="Center">
                                    <Label Text="   #" WidthRequest="50" FontSize="16" TextDecorations="Underline"/>
                                    <Label Text="Service job" WidthRequest="340" FontSize="16" TextDecorations="Underline"/>
                                    <Label Text="Hours" WidthRequest="50" FontSize="16" TextDecorations="Underline"/>
                                </HorizontalStackLayout>
                                <ListView x:Name="serviceJobs" ItemSelected="serviceJobs_ItemSelected"
                                            HeightRequest="200" WidthRequest="440" Background="AliceBlue">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <ViewCell>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"></RowDefinition>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"></ColumnDefinition>
                                                        <ColumnDefinition Width="340"></ColumnDefinition>
                                                        <ColumnDefinition Width="50"></ColumnDefinition>
                                                    </Grid.ColumnDefinitions>
                                                    <Label Grid.Column="0" Text="{Binding ServiceJobId}" HorizontalOptions="Center"/>
                                                    <Label Grid.Column="1" Text="{Binding ServiceJobDescription}"/>
                                                    <Label Grid.Column="2" Text="{Binding ServiceJobHours}" HorizontalOptions="Start"/>
                                                </Grid>
                                            </ViewCell>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </VerticalStackLayout>
                        </Border>
                        <HorizontalStackLayout x:Name="thisJob" HorizontalOptions="Center">
                            <Entry Text="{Binding ServiceJobId}"
                                    WidthRequest="50" HorizontalTextAlignment="Center"/>
                            <Entry Text="{Binding ServiceJobDescription}"
                                    WidthRequest="340"/>
                            <Entry Text="{Binding ServiceJobHours}"
                                    WidthRequest="50"/>
                        </HorizontalStackLayout>
                        <Button Text="Add This Job" WidthRequest="400"
                                x:Name="addThisJob" Clicked="addThisJob_Clicked"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </HorizontalStackLayout>
    </ScrollView>
</ContentPage>